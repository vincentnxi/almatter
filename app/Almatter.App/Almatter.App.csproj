<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net10.0, not net10.0-windows: the same project then builds on
         Linux and macOS, and the compiler points out any call to a
         Windows-only API that isn't behind an OperatingSystem.IsWindows()
         check. See docs/PLATFORM_PORTABILITY.md. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- The executable, and therefore the name in Task Manager, is
         "Almatter" rather than the project name. RootNamespace is pinned
         because it otherwise follows AssemblyName, and every namespace in
         the codebase is Almatter.App.*. -->
    <AssemblyName>Almatter</AssemblyName>
    <RootNamespace>Almatter.App</RootNamespace>
    <Version>0.9.2</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\almatter-logo.ico</ApplicationIcon>

    <!-- Memory, which is the whole point of this app existing.

         Server GC would give each of the machine's cores its own heap with
         its own generous allocation budget — right for a web server with
         nothing else on the machine, exactly wrong for a chat window meant
         to sit in the tray all day next to everything else the user runs.
         It is already the default for a desktop app; pinned here so it stays
         that way.

         Concurrent (background) GC buys shorter pauses by keeping a
         dedicated collector thread and a bigger committed heap. Measured
         here the heap is small enough — around 48 MB live — that a blocking
         collection is a few milliseconds, so it trades a thread and tens of
         megabytes of headroom for a pause nobody can see.

         RetainVM would keep memory reserved from Windows after the collector
         is finished with it, to hand out again later without asking. Faster
         if the app keeps re-growing; here it just means Task Manager never
         shows the memory coming back down.

         System.GC.ConserveMemory (0-9, no MSBuild property of its own, hence
         runtimeconfig.template.json next to this file) tells the collector to
         work harder at compacting rather than committing more. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Rust core, built separately: `cargo build` (Debug config here) or
         a release-mode Cargo build (Release config) in ../../core. Picks
         the matching Cargo profile's library so a Release build doesn't
         silently ship without the core (or with a stale Debug one) just
         because only a debug artifact happened to exist on disk.

         Cargo names the file after the system it builds on; NativeCore.cs
         asks for "almatter_ffi" with no extension and .NET finds whichever
         of the three is there. -->
    <CoreLibrary>almatter_ffi.dll</CoreLibrary>
    <CoreLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">libalmatter_ffi.so</CoreLibrary>
    <CoreLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">libalmatter_ffi.dylib</CoreLibrary>
    <CoreProfile>debug</CoreProfile>
    <CoreProfile Condition="'$(Configuration)' == 'Release'">release</CoreProfile>
    <CoreLibraryPath>..\..\core\target\$(CoreProfile)\$(CoreLibrary)</CoreLibraryPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(CoreLibraryPath)" Condition="Exists('$(CoreLibraryPath)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>$(CoreLibrary)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>
</Project>
