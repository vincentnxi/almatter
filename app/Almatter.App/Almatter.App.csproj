<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net10.0, not net10.0-windows: the same project then builds on
         Linux and macOS, and the compiler points out any call to a
         Windows-only API that isn't behind an OperatingSystem.IsWindows()
         check. See docs/PLATFORM_PORTABILITY.md. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- The executable, and therefore the name in Task Manager, is
         "Almatter" rather than the project name. RootNamespace is pinned
         because it otherwise follows AssemblyName, and every namespace in
         the codebase is Almatter.App.*. -->
    <AssemblyName>Almatter</AssemblyName>
    <RootNamespace>Almatter.App</RootNamespace>
    <Version>0.20.0</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\almatter-logo.ico</ApplicationIcon>

    <!-- Memory, which is the whole point of this app existing.

         Server GC would give each of the machine's cores its own heap with
         its own generous allocation budget — right for a web server with
         nothing else on the machine, exactly wrong for a chat window meant
         to sit in the tray all day next to everything else the user runs.
         It is already the default for a desktop app; pinned here so it stays
         that way.

         Concurrent (background) GC buys shorter pauses by keeping a
         dedicated collector thread and a bigger committed heap. Measured
         here the heap is small enough — around 48 MB live — that a blocking
         collection is a few milliseconds, so it trades a thread and tens of
         megabytes of headroom for a pause nobody can see.

         RetainVM would keep memory reserved from Windows after the collector
         is finished with it, to hand out again later without asking. Faster
         if the app keeps re-growing; here it just means Task Manager never
         shows the memory coming back down.

         System.GC.ConserveMemory (0-9, no MSBuild property of its own, hence
         the RuntimeHostConfigurationOption item below) tells the collector to
         work harder at compacting rather than committing more. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>

    <!-- Native AOT: `dotnet publish -r <rid>` compiles the whole app ahead
         of time into one native executable. No .NET runtime to install, no
         JIT compiler loaded at startup. Measured on 2026-11-25 against the
         framework-dependent build of the same code: the window appears in
         about 0.1 s instead of 0.8 s, and about 40 MB less memory is in use
         (working set 113 vs 154 MB; private memory 68 vs 75 MB).

         Only `dotnet publish` is affected: `dotnet build` and F5 still give
         an ordinary JIT build. Publishing needs the platform's native
         linker (on Windows the Visual Studio C++ build tools, which the
         Rust core needs anyway) and only works for the OS it runs on.

         Every reflection-based API is off limits from here on: the
         compiler's warnings (IL2xxx, IL3xxx) must stay at zero, a new one
         is a real break in the published app. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Set here rather than in runtimeconfig.template.json: a Native AOT
         publish ignores that file, and this item reaches both kinds of build. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <!-- The unit tests (../Almatter.App.Tests) check internal helpers too. -->
    <InternalsVisibleTo Include="Almatter.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- A Debug build wears the logo with a yellow folded corner, in every
       tint (tools/generate-app-icon.ps1 draws both sets): its executable,
       shortcuts, taskbar button, windows and notification-area icon, so a
       build from the repo is never taken for the installed app. The marked
       files stand in for the plain ones at the same resource paths, so no
       code or XAML changes; Release and the installer never see them. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationIcon>DebugAssets\almatter-logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AvaloniaResource Remove="Assets\almatter-logo.ico;Assets\almatter-logo.png;Assets\AppIcons\*.ico" />
    <AvaloniaResource Include="DebugAssets\almatter-logo.ico" Link="Assets\almatter-logo.ico" />
    <AvaloniaResource Include="DebugAssets\almatter-logo.png" Link="Assets\almatter-logo.png" />
    <AvaloniaResource Include="DebugAssets\AppIcons\*.ico" Link="Assets\AppIcons\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Rust core, built separately: `cargo build` (Debug config here) or
         a release-mode Cargo build (Release config) in ../../core. Picks
         the matching Cargo profile's library so a Release build doesn't
         silently ship without the core (or with a stale Debug one) just
         because only a debug artifact happened to exist on disk.

         Cargo names the file after the system it builds on; NativeCore.cs
         asks for "almatter_ffi" with no extension and .NET finds whichever
         of the three is there. -->
    <CoreLibrary>almatter_ffi.dll</CoreLibrary>
    <CoreLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">libalmatter_ffi.so</CoreLibrary>
    <CoreLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">libalmatter_ffi.dylib</CoreLibrary>
    <CoreProfile>debug</CoreProfile>
    <CoreProfile Condition="'$(Configuration)' == 'Release'">release</CoreProfile>
    <CoreLibraryPath>..\..\core\target\$(CoreProfile)\$(CoreLibrary)</CoreLibraryPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(CoreLibraryPath)" Condition="Exists('$(CoreLibraryPath)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>$(CoreLibrary)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>
</Project>
